PORT=3000

# Postgres (Docker Compose)
DB_HOST=localhost
DB_PORT=5432
DB_USER=agendaai
DB_PASSWORD=agendaai_dev
DB_NAME=agendaai
# Dev only: liga schema sync automatico do TypeORM. Em prod, false + migrations.
DB_SYNC=true

# JWT
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# Fuso da clinica - regula como horarios "wall-clock" (08:00, 14:00) sao interpretados.
TZ=America/Sao_Paulo

# Misc
NODE_ENV=development
